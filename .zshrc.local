# Some of the most useful features in emacs-libvterm require shell-side
# configurations. The main goal of these additional functions is to enable the
# shell to send information to `vterm` via properly escaped sequences. A
# function that helps in this task, `vterm_printf`, is defined below.

alias hig="history | grep"

# In some containers the inherited HOST variable is a bind address such as
# 0.0.0.0. Zsh uses $HOST for prompt escapes like %m, which makes the Radian
# prompt show epd@0. Prefer the actual container hostname in that case.
if [[ -z ${RADIAN_HOSTNAME:-} && ( ${HOST:-} == 0.0.0.0 || ${HOST:-} == 0 ) ]]; then
    if [[ -n ${HOSTNAME:-} ]]; then
        RADIAN_HOSTNAME=${HOSTNAME%%.*}
    elif (( $+commands[hostname] )); then
        RADIAN_HOSTNAME=$(hostname -s 2>/dev/null || hostname 2>/dev/null)
    fi
fi

alias githubUp='ssh -fN -L 4444:ssh.github.com:443 login'
alias summitUp='ssh -fN -L 4447:summit.olcf.ornl.gov:22 login'
alias condoUp='ssh -fN -L 4445:or-condo-login01.ornl.gov:22 login'
# `xterm-direct' is the system terminfo entry that advertises 24-bit RGB
# color to Emacs.  Do not use the old, host-local xterm-24bit(s) entry.
export COLORTERM=truecolor
alias nwemacs='TERM=xterm-direct COLORTERM=truecolor emacs -nw'

vterm_printf() {
    if [ -n "$TMUX" ] \
        && { [ "${TERM%%-*}" = "tmux" ] \
            || [ "${TERM%%-*}" = "screen" ]; }; then
        # Tell tmux to pass the escape sequences through
        printf "\ePtmux;\e\e]%s\007\e\\" "$1"
    elif [ "${TERM%%-*}" = "screen" ]; then
        # GNU screen (screen, screen-256color, screen-256color-bce)
        printf "\eP\e]%s\007\e\\" "$1"
    else
        printf "\e]%s\e\\" "$1"
    fi
}

# With vterm_cmd you can execute Emacs commands directly from the shell.
# For example, vterm_cmd message "HI" will print "HI".
# To enable new commands, you have to customize Emacs's variable
# vterm-eval-cmds.
vterm_cmd() {
    local vterm_elisp
    vterm_elisp=""
    while [ $# -gt 0 ]; do
        vterm_elisp="$vterm_elisp""$(printf '"%s" ' "$(printf "%s" "$1" | sed -e 's|\\|\\\\|g' -e 's|"|\\"|g')")"
        shift
    done
    vterm_printf "51;E$vterm_elisp"
}

# This is to change the title of the buffer based on information provided by the
# shell. See, http://tldp.org/HOWTO/Xterm-Title-4.html, for the meaning of the
# various symbols.
# autoload -U add-zsh-hook
# add-zsh-hook -Uz chpwd (){ print -Pn "\e]2;%m:%2~\a" }

# Sync directory and host in the shell with Emacs's current directory.
# You may need to manually specify the hostname instead of $(hostname) in case
# $(hostname) does not return the correct string to connect to the server.
#
# The escape sequence "51;A" has also the role of identifying the end of the
# prompt
vterm_prompt_end() {
    vterm_printf "51;A$(whoami)@$(hostname):$(pwd)"
}

# znap is initialized by Radian after this file is sourced, then calls this
# hook. Cloning here ensures the fzf installer is available on the first shell.
radian_znap_hook() {
    znap clone junegunn/fzf
}

# Completely clear the buffer. With this, everything that is not on screen
# is erased.
radian_after_init_hook() {
    local host_name host_domain spack_setup fzf_dir
    host_name=$(hostname 2>/dev/null || true)
    host_domain=$(hostname -d 2>/dev/null || true)

    # autoload -Uz promptinit
    # promptinit
    # prompt adam1

    alias hig="history | grep"

    # vterm and terminal Emacs both support direct RGB color.  `export' is
    # required so Emacs and child processes inherit the setting.
    export EMACS_TERM=xterm-direct
    export COLORTERM=truecolor
    alias nwemacs='TERM=xterm-direct COLORTERM=truecolor emacs -nw'

    autoload -U bashcompinit
    bashcompinit

    if [[ $host_domain = "frontier.olcf.ornl.gov" ]]; then
        fpath=( $fpath /etc/zsh_completion.d )
        spack_setup=${PROJWORK:-}/cph102/epd/fresh-spack/share/spack/setup-env.sh
        [[ -f $spack_setup ]] && . $spack_setup
    elif [[ $host_name = "a30four" ]]; then
        echo "On a30four"
        fpath+=(~/my_configs/zsh)
        [[ -f /scratch/spack/share/spack/setup-env.sh ]] && . /scratch/spack/share/spack/setup-env.sh
        HF_HOME=/scratch/caches/hf
    elif (( ! $+functions[spack] )); then
        if [[ -n ${SPACK_ROOT:-} && -f ${SPACK_ROOT}/share/spack/setup-env.sh ]]; then
            . ${SPACK_ROOT}/share/spack/setup-env.sh
        elif [[ -f ~/spack/share/spack/setup-env.sh ]]; then
            . ~/spack/share/spack/setup-env.sh
        fi
    fi

    if [[ "$INSIDE_EMACS" = 'vterm' ]]; then
      alias clear='vterm_printf "51;Evterm-clear-scrollback";tput clear'
      PROMPT="${PROMPT}$(printf '%s' '%{$(vterm_prompt_end)%}')"
    fi

    if [[ $host_domain = "sns.gov" && -f /raid/epd/spack/share/spack/setup-env.sh ]]; then
        . /raid/epd/spack/share/spack/setup-env.sh
    fi

    bindkey '^[[H' beginning-of-line  # Home key
    bindkey '^[[F' end-of-line        # End key
    bindkey '^[OH' beginning-of-line # Home again
    bindkey '^[OF' end-of-line       # end again
    bindkey '^A' beginning-of-line    # Ctrl-A
    bindkey '^E' end-of-line          # Ctrl-E


    if (( $+commands[eza] )); then
        function ltr {
            emulate -LR zsh
            eza --all --header --long --color-scale=all -t modified -r $@
        }
    fi

    if [[ "$OSTYPE" == darwin* ]]; then
      export PATH="/opt/homebrew/opt/curl/bin:$PATH"
    fi
    export PATH=~/opt/bin:${PATH}
    export PATH=/usr/local/go/bin:${PATH}

    fzf_dir=$HOME/.local/share/znap/junegunn/fzf
    if [[ -d $fzf_dir ]]; then
        export PATH=$fzf_dir/bin:$PATH

        # The upstream installer knows the release version and installs only
        # the binary, leaving this configuration as the single source of the
        # zsh bindings. It downloads a matching release binary and falls back
        # to Go when no prebuilt binary is available.
        if [[ ! -x $fzf_dir/bin/fzf ]]; then
            if (( $+commands[bash] )) && [[ -x $fzf_dir/install ]]; then
                command bash "$fzf_dir/install" --bin ||
                    print -u2 'fzf installation failed; rerun the installer after resolving its prerequisites.'
            else
                print -u2 'fzf installation requires bash and the fzf install script.'
            fi
        fi
    fi

    if (( $+commands[fzf] )) && [[ -t 0 ]]; then
        source <(fzf --zsh 2>/dev/null)
    fi
}
