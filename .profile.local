# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# if running bash
if [[ $(hostname -d) = "frontier.olcf.ornl.gov" ]]; then
    echo "on frontier"
else
    if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
        if [ -f "$HOME/.bashrc" ]; then
	    . "$HOME/.bashrc"
        fi
    fi
fi

if [[ $(hostname -d) = "mac117825" ]]; then
   if [ -d "/Applications/Emacs.app/Contents/MacOS/bin" ]; then
       export PATH="/Applications/Emacs.app/Contents/MacOS/bin:$PATH"
   fi

   # set PATH so it includes user's private bin if it exists
   if [ -d "$HOME/bin" ] ; then
       PATH="$HOME/bin:$PATH"
   fi

   # set PATH so it includes user's private bin if it exists
   if [ -d "$HOME/.local/bin" ] ; then
       PATH="$HOME/.local/bin:$PATH"
   fi

   export HOMEBREW_TEMP=/Users/Shared/ornldev/projects/brew_temp
fi

# We need a currect zsh in the path

if [[ $(hostname -d) = "frontier.olcf.ornl.gov" ]]; then
    PATH="/lustre/orion/cph102/proj-shared/epd/fresh-spack/opt/spack/linux-zen3/zsh-5.9.0.2-tm5phpzrwwohrsxgo274j32vxioblkqj/bin:${PATH}"
elif [[ $(hostname) = "a30four" ]]; then
    HF_HOME="/scratch/caches/hf"
elif [ -d "/raid/epd/spack/opt/spack/linux-skylake_avx512/zsh-5.9.0.2-a5gtwakb7lxtthuszyqodbbmmyyyzq7p/bin" ]; then
    PATH="/raid/epd/spack/opt/spack/linux-skylake_avx512/zsh-5.9.0.2-a5gtwakb7lxtthuszyqodbbmmyyyzq7p/bin:$PATH"
elif [ -d "$HOME/spack/bin" ]; then
    PATH="$HOME/spack/bin:$PATH"
fi

# Container-provided tools that should survive dotfile startup. In particular,
# /etc/profile in minimal containers can reset PATH, so put these back if they
# exist without creating duplicates.
path_prepend_once() {
    if [ -n "$1" ] && [ -d "$1" ]; then
        case ":$PATH:" in
            *:"$1":*) ;;
            *) PATH="$1:$PATH" ;;
        esac
    fi
}
path_prepend_once "$HOME/.cargo/bin"
path_prepend_once "$HOME/.venv/bin"
path_prepend_once "$HOME/.local/node/bin"
path_prepend_once "/app/node_modules/.bin"
path_prepend_once "$HOME/spack/bin"
path_prepend_once "$HOME/.local/bin"
path_prepend_once "$HOME/.pi/agent/bin"
unset -f path_prepend_once 2>/dev/null || unset path_prepend_once

TERMINFO=$HOME/.terminfo

# set PATH so it includes homebrew sbin
if [ -d /usr/local/sbin ] ; then
    PATH="/usr/local/sbin:$PATH"
fi
